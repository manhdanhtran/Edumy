# Copy to .env (git-ignored) and change the values. Never commit .env.
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# JWT HS256 secret, >= 32 random bytes, base64 (docs/ai/04 §4.1). Required outside the dev/test profiles.
# Generate: openssl rand -base64 32
EDUMY_JWT_SECRET=

# SPA origin used to build the links in emails (docs/ai/05 "Front-end routes used in emails"). Default http://localhost:5173
EDUMY_FRONTEND_BASE_URL=http://localhost:5173
# From: address of every email. Default no-reply@edumy.test
EDUMY_MAIL_FROM=no-reply@edumy.test
